{
  "name": "veyli-colour-nuxt",
  "version": "0.1.0",
  "description": "An expressive beauty storefront with named shades, a colour-story builder and a simulated shopping journey",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1 --port 4204",
    "build": "nuxt generate",
    "preview": "node scripts/preview.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@pinia/nuxt": "1.0.3",
    "nuxt": "4.6.4",
    "pinia": "4.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "packageManager": "npm@10.9.8"
}
